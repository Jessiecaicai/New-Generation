# LLM (Ollama)
AGENT_OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_LLM_MODEL=qwen2.5:7b

# Path Configuration (change DATA_ROOT to change all paths)
AGENT_DATA_ROOT=./data
# AGENT_KNOWLEDGE_UPLOAD_DIR=./data/knowledge/uploads
# AGENT_VECTORDB_DIR=./data/vectordb/chroma
# AGENT_LOG_DIR=./data/logs
# AGENT_EXPORT_DIR=./data/export
# AGENT_TEMP_DIR=./data/temp

# File Limits
AGENT_KNOWLEDGE_MAX_FILE_SIZE_MB=50
AGENT_TEMP_CLEANUP_HOURS=24

# Database
MYSQL_ROOT_PASSWORD=rootpass
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/business_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpass

# Services
AGENT_SERVICE_URL=http://localhost:8001
AGENT_JAVA_BACKEND_URL=http://localhost:8080
